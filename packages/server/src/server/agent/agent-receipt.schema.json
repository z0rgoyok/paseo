{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Общая квитанция агента Paseo",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_type": {
          "const": "task_started"
        },
        "take_comment": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://tracker\\.tich\\.app/project/[A-Za-z0-9_]+/issue/[1-9][0-9]*#comment-[1-9][0-9]*$",
          "maxLength": 2048
        }
      },
      "required": ["receipt_type", "take_comment"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_type": {
          "const": "task_state"
        },
        "take_comment": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://tracker\\.tich\\.app/project/[A-Za-z0-9_]+/issue/[1-9][0-9]*#comment-[1-9][0-9]*$",
          "maxLength": 2048
        },
        "status": {
          "enum": ["working", "waiting_agents", "needs_product_decision", "infra_blocked", "done"]
        },
        "completion_comment": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://tracker\\.tich\\.app/project/[A-Za-z0-9_]+/issue/[1-9][0-9]*#comment-[1-9][0-9]*$",
          "maxLength": 2048
        },
        "blocker_comment": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://tracker\\.tich\\.app/project/[A-Za-z0-9_]+/issue/[1-9][0-9]*#comment-[1-9][0-9]*$",
          "maxLength": 2048
        }
      },
      "required": ["receipt_type", "take_comment", "status"],
      "oneOf": [
        {
          "properties": {
            "status": {
              "enum": ["working", "waiting_agents"]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": ["completion_comment"]
              },
              {
                "required": ["blocker_comment"]
              }
            ]
          }
        },
        {
          "properties": {
            "status": {
              "enum": ["needs_product_decision", "infra_blocked"]
            }
          },
          "required": ["blocker_comment"],
          "not": {
            "required": ["completion_comment"]
          }
        },
        {
          "properties": {
            "status": {
              "const": "done"
            }
          },
          "required": ["completion_comment"],
          "not": {
            "required": ["blocker_comment"]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_type": {
          "const": "review_completed"
        },
        "take_comment": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://tracker\\.tich\\.app/project/[A-Za-z0-9_]+/issue/[1-9][0-9]*#comment-[1-9][0-9]*$",
          "maxLength": 2048
        },
        "review_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "verdict": {
          "enum": ["approved", "changes_requested", "blocked"]
        }
      },
      "required": ["receipt_type", "take_comment", "review_artifact", "verdict"]
    }
  ]
}
